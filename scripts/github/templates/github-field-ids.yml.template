# GitHub Projects v2 Field IDs Template
# Format: Pure YAML (no frontmatter)
# Purpose: Template for storing field IDs after creation for efficient API operations
# Source: scripts/github/templates/github-field-ids.yml.template
# Destination: .baton/github-field-ids.yml (generated by setup scripts)
# Note: This file is generated by setup scripts and should be gitignored
# Example structure - actual file will be generated by setup-project.sh/ps1
#
# NOTE: This is a template file. Setup scripts will copy this to .baton/github-field-ids.yml
# and populate field IDs after creating the project and custom fields.

# Field IDs are populated after field creation via GitHub Projects v2 API
# These IDs are used for efficient field value updates without querying API each time

project:
  id: null  # Project ID (will be populated after project creation)
  name: null  # Project name (will be populated from config)

custom_fields:
  - name: "Status"
    id: null  # Field ID (will be populated after field creation)
  - name: "TEMPO"
    id: null  # Field ID (will be populated after field creation)
  - name: "Assigned Agent"
    id: null  # Field ID (will be populated after field creation)
  - name: "Estimated Tokens"
    id: null  # Field ID (will be populated after field creation)
  - name: "Actual Tokens"
    id: null  # Field ID (will be populated after field creation)
  - name: "Bug Relationship"
    id: null  # Field ID (will be populated after field creation)
  - name: "Severity"
    id: null  # Field ID (will be populated after field creation)

# Usage in scripts:
# 1. After creating project, store project ID
# 2. After creating each field, store field ID
# 3. Use stored IDs for field value updates (more efficient than querying API)
# 4. If file doesn't exist, scripts can query API to get IDs (fallback)
