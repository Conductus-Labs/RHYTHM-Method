# GitHub Configuration Template for RHYTHM Method
# Format: Pure YAML (no frontmatter)
# Purpose: Template for centralized configuration for GitHub Issues setup using native GitHub features
# Source: scripts/github/templates/github-config.yml.template
# Destination: .baton/github-config.yml (copied by setup scripts)
# Version: 1.0.0
# Created: 2025-11-26
# GitHub API Version: 2022-11-28 (Projects v2 API)
# Minimum GitHub CLI Version: 2.30.0 (for Issue Types and Projects v2 support)
# Minimum GitHub Organization Plan: Free (Issue Types and Projects v2 available on all plans)
# Compatibility Note: Verify API field types and color formats during setup script implementation
#
# NOTE: This is a template file. Setup scripts will copy this to .baton/github-config.yml
# and populate user-specific values (organization, repository, project name, etc.)

# GitHub organization and repository configuration
# NOTE: These values can be auto-detected from current repository or provided by user during setup
# Setup scripts should:
#   1. Try to auto-detect from current git repository (gh repo view)
#   2. Prompt user for values if auto-detection fails or user wants to override
github:
  organization: null  # Will be auto-detected from current repository or provided by user
  repository: null  # Will be auto-detected from current repository or provided by user

# Issue Types Configuration
# These will be created at the organization level using GitHub Issue Types feature
# Reference: https://docs.github.com/en/issues/tracking-your-work-with-issues/using-issues/managing-issue-types-in-an-organization
# Note: Verify GitHub Issue Types API accepts hex color format (#RRGGBB) or if it requires color names
# Setup scripts should validate color format before creating issue types
issue_types:
  - name: "Feature"
    description: "Deliverable unit of functionality that provides business value"
    color: "#1f77b4"  # Blue - verify API accepts hex format
  - name: "Work Unit"
    description: "Specific piece of work completed in a single execution cycle (up to 8 hours)"
    color: "#2ca02c"  # Green - verify API accepts hex format
  - name: "Agent Task"
    description: "Smallest unit of executable work (typically 30 minutes to 2 hours)"
    color: "#ff7f0e"  # Orange - verify API accepts hex format
  - name: "Bug"
    description: "Defect or issue that needs to be fixed"
    color: "#d62728"  # Red - verify API accepts hex format

# GitHub Projects v2 Configuration
# Project will be created and linked to the repository
# Custom fields will be created in the project
# Reference: https://docs.github.com/en/issues/planning-and-tracking-with-projects/understanding-projects/working-with-projects-v2
# Field IDs: After field creation, IDs will be stored in .baton/github-field-ids.yml (generated by setup scripts)
# This file should be gitignored to avoid conflicts between environments
# NOTE: Project name, description, and repository should be provided by user during setup
# Setup scripts should:
#   1. Auto-detect repository from current git repository (gh repo view)
#   2. Prompt user for project name and description
#   3. Allow user to override auto-detected repository if needed
project:
  name: null  # Will be prompted from user during setup (e.g., "RHYTHM Method Project")
  visibility: "private"  # Options: "private" (default for org projects) or "public"
  description: null  # Will be prompted from user during setup (e.g., "RHYTHM Method work item tracking and management")
  repository: null  # Will be auto-detected from current repository (format: "org/repo") or provided by user
  custom_fields:
    # Status field - Required, tracks work item status
    # Note: Verify GitHub Projects v2 API field type name is "single_select" (not "SingleSelect" or other variants)
    - name: "Status"
      type: "single_select"  # Verify API accepts this exact field type name
      options:
        - "Planned"
        - "In Progress"
        - "Review"
        - "Blocked"
        - "Completed"
        - "Failed"
      required: true
      # Field ID will be stored in .baton/github-field-ids.yml after creation

    # TEMPO field - Required, tracks agent speed/pace
    - name: "TEMPO"
      type: "single_select"  # Verify API accepts this exact field type name
      options:
        - "High"
        - "Moderate"
        - "Controlled"
      required: true
      default: "Moderate"
      # Field ID will be stored in .baton/github-field-ids.yml after creation

    # Assigned Agent field - Optional, tracks which agent is assigned (for Agent Tasks)
    # DYNAMIC FIELD: Options are populated from .baton/project.config.yml during setup
    # Source: .baton/project.config.yml
    # Path: agents.enabled[].name
    # Example structure in project.config.yml:
    #   agents:
    #     enabled:
    #       - name: baton-agent
    #       - name: technical-writer-agent
    #       - name: rhythm-expert-agent
    # Validation Requirements:
    #   - At least 1 agent must be configured (min_options: 1)
    #   - Maximum 25 options (GitHub Projects v2 single select field limit)
    #   - If source file missing or empty, field creation should fail with clear error
    # Example agents from this project: baton-agent, technical-writer-agent, rhythm-expert-agent,
    #   cli-engineer-agent, research-assistant-agent, devops-engineer-agent
    - name: "Assigned Agent"
      type: "single_select"  # Verify API accepts this exact field type name
      options: []  # Will be populated dynamically from project.config.yml by setup scripts
      required: false
      dynamic: true  # Indicates this field should be populated from project config
      source: ".baton/project.config.yml"  # Source file for agent list
      source_path: "agents.enabled[].name"  # JSONPath/YAML path to extract agent names
      validation:
        min_options: 1  # At least one agent must be configured
        max_options: 25  # GitHub Projects v2 single select field limit
      # Field ID will be stored in .baton/github-field-ids.yml after creation

    # Estimated Tokens field - Optional, tracks estimated token usage
    # Validation: min: 0, max: 1000000 (reasonable upper limit)
    - name: "Estimated Tokens"
      type: "number"  # Verify API accepts this exact field type name
      required: false
      validation:
        min: 0
        max: 1000000  # Reasonable upper limit for token estimates
      # Field ID will be stored in .baton/github-field-ids.yml after creation

    # Actual Tokens field - Optional, tracks actual token usage
    # Validation: min: 0, max: 1000000 (reasonable upper limit)
    - name: "Actual Tokens"
      type: "number"  # Verify API accepts this exact field type name
      required: false
      validation:
        min: 0
        max: 1000000  # Reasonable upper limit for token tracking
      # Field ID will be stored in .baton/github-field-ids.yml after creation

    # Duration fields - Optional, tracks duration in hours
    # NOTE: RHYTHM Method is token-based, not time-based. Duration fields are optional
    # and may not be needed since agents operate faster than users and token-based
    # estimation is the primary method. Duration is a guideline (Work Units up to 8 hours)
    # but not a hard requirement. These fields are included for optional tracking only.
    # - name: "Estimated Duration"
    #   type: "number"
    #   required: false
    #   note: "Optional - RHYTHM Method is token-based, duration is guideline only"
    #
    # - name: "Actual Duration"
    #   type: "number"
    #   required: false
    #   note: "Optional - RHYTHM Method is token-based, duration is guideline only"

    # Bug Relationship field - Optional, tracks bug relationship type (for Bugs only)
    - name: "Bug Relationship"
      type: "single_select"  # Verify API accepts this exact field type name
      options:
        - "Parented"
        - "Related"
      required: false
      # Field ID will be stored in .baton/github-field-ids.yml after creation

    # Severity field - Optional, tracks bug severity (for Bugs only)
    - name: "Severity"
      type: "single_select"  # Verify API accepts this exact field type name
      options:
        - "Critical"
        - "High"
        - "Medium"
        - "Low"
      required: false
      # Field ID will be stored in .baton/github-field-ids.yml after creation
